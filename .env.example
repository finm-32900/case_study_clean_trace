WRDS_USERNAME="username"

# Date range. By default, the pipeline pulls only a small 2-month sample
# (Jan-Feb 2024) so you can run end-to-end quickly. To pull the full
# TRACE history, uncomment and set explicit dates:
# START_DATE=2002-07-01
# END_DATE=2025-12-31

# N_CORES=4  # Optional: cap parallel workers (auto-detects if not set)
